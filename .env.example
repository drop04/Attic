# Required: long random bearer token (python -c "import secrets; print(secrets.token_urlsafe(32))")
ATTIC_TOKEN=
ATTIC_DATA=./data
ATTIC_HOST=127.0.0.1
ATTIC_PORT=8787
# Comma-separated Host headers the server accepts (add your tunnel hostname)
ATTIC_ALLOWED_HOSTS=localhost:8787,127.0.0.1:8787
# Optional cloud tier (AWS Bedrock). Leave empty to stay fully local.
ATTIC_BEDROCK_MODEL=
AWS_REGION=us-east-1
